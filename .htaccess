# Protección básica del sitio (funciona con Apache en XAMPP)
Options -Indexes
AddDefaultCharset UTF-8

# App instalable (PWA)
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

# Bloquear acceso a carpetas internas desde el navegador
RedirectMatch 403 /(inc|database|scripts|cache|tests|docker)(/|$)

# Si no está Apache, PHP embebido también bloquea por su cuenta
php_flag display_errors On